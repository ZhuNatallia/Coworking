# Скопируйте в .env.local и заполните.
# Без переменных Supabase приложение работает в локальном режиме:
# данные хранятся в файле .data/db.json (только для разработки).

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный ключ service_role. Используется только на сервере, никогда не публикуйте его.
SUPABASE_SERVICE_ROLE_KEY=

# Случайная строка от 32 символов для подписи cookie сессии.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Пароль для демо-пользователей, которых создаёт npm run seed.
SEED_PASSWORD=officecare
